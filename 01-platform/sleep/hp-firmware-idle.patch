+static void hp_n1x_prepare_flat_lpi_state(const struct acpi_lpi_state *lpi,
+					struct cpuidle_state *state,
+					unsigned int index)
+{
+	if (!hp_n1x_firmware_idle_requested() || !index ||
+	    lpi->entry_method != ACPI_CSTATE_FFH)
+		return;
+
+	/* Ryan Hughes' N1x DRIPS selection quirk, with saturating arithmetic. */
+	if (lpi->min_residency == U32_MAX) {
+		if (state->exit_latency > U32_MAX - 6610)
+			state->exit_latency = U32_MAX;
+		else
+			state->exit_latency += 6610;
+	}
+	/* FFH entry preserves disabled IRQs; freeze the tick/timekeeping too. */
+	state->enter_s2idle = acpi_idle_lpi_enter_direct;
+}
